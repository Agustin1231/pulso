# ── PostgreSQL ───────────────────────────────────────────────
# La app se conecta con el rol `pulso_app`: solo lee y escribe datos, no
# puede cambiar el schema y está sujeta a Row Level Security (cada usuario
# ve solo lo suyo). En Coolify usá el hostname interno de la base, no localhost.
DATABASE_URL=postgres://pulso_app:CAMBIAME@postgres-pulso:5432/pulso

# Solo para `npm run setup-db`, que crea tablas, roles y políticas: el rol
# DUEÑO de la base. No se lo pases a la app.
DATABASE_ADMIN_URL=postgres://postgres:CAMBIAME@postgres-pulso:5432/pulso

# Solo para `npm run setup-db`: habilita el login de `pulso_app` con esta
# contraseña (mínimo 24 caracteres). Generala con: openssl rand -hex 24
PULSO_APP_PASSWORD=

# TLS hacia Postgres:
#   verify-full → cifra y verifica el certificado contra PGSSL_CA (producción:
#                 la base de Coolify con SSL activado; PGSSL_CA es la CA de
#                 Coolify, /data/coolify/ssl/coolify-ca.crt en el servidor)
#   require     → cifra sin verificar (Postgres gestionado: Neon, RDS, Supabase)
#   vacío       → sin TLS (desarrollo con una base local)
PGSSL=
PGSSL_CA=

# Tamaño máximo del pool de conexiones (opcional, default 10)
PGPOOL_MAX=10

# ── Almacenamiento de archivos ───────────────────────────────
# Directorio donde se guardan las imágenes de recetas (reemplaza Supabase
# Storage). En producción tiene que ser un volumen PERSISTENTE de Coolify,
# o las imágenes se pierden en cada deploy. En dev cae a ./.data
MEDIA_DIR=/data

# ── Zona horaria ─────────────────────────────────────────────
# El upsert diario de métricas usa la hora del servidor. Fijala para que
# coincida con la de tus usuarios.
TZ=America/Argentina/Buenos_Aires

# ── Claude (Anthropic) — IA principal ───────────────────────
# Dos modos de auth:
#   apikey (default) → ANTHROPIC_API_KEY contra la API de Anthropic
#   oauth            → proxy interno que resuelve con la suscripción
CLAUDE_AUTH_MODE=apikey

# Solo para CLAUDE_AUTH_MODE=oauth, y el proxy TIENE que ser https:// (o
# http://localhost en desarrollo): los prompts llevan datos de salud. Con un
# proxy en http:// plano, la app lo ignora y usa la API de Anthropic.
CLAUDE_PROXY_URL=
CLAUDE_PROXY_TOKEN=

# Requerida en modo apikey. En modo oauth no se usa, pero dejala puesta
# para poder volver atrás cambiando una sola variable.
ANTHROPIC_API_KEY=sk-ant-...

# ── Gemini (Google) — Generación de imágenes de recetas ─────
GEMINI_API_KEY=AIza...

# ── Web Push (VAPID) — Notificaciones ────────────────────────
# Generá el par con:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:tu@email.com
