{
  "name": "pulso",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup-db": "node scripts/setup-db.mjs",
    "test:fallback": "tsc src/lib/ai/provider.ts --outDir .tmp-test --module esnext --target es2022 --moduleResolution bundler --skipLibCheck && node tests/provider-fallback.mjs",
    "test:ml": "tsc -p tsconfig.ml.json && node --test \".tmp-test/ml/tests/ml/**/*.test.js\"",
    "test:seguridad": "node --test tests/seguridad/",
    "evaluar": "tsc -p tsconfig.ml.json && node .tmp-test/ml/scripts/evaluar.js",
    "test": "npm run test:fallback && npm run test:ml",
    "seed:demo": "tsc -p tsconfig.ml.json && node .tmp-test/ml/scripts/seed-demo.js",
    "entrenar": "tsc -p tsconfig.ml.json && node .tmp-test/ml/scripts/entrenar.js",
    "nhanes:descargar": "mkdir -p data/nhanes-2021-2023/xpt && for f in DEMO_L BPXO_L BMX_L SLQ_L DPQ_L MCQ_L SMQ_L; do curl -fsSL -o data/nhanes-2021-2023/xpt/$f.xpt https://wwwn.cdc.gov/Nchs/Data/Nhanes/Public/2021/DataFiles/$f.xpt || exit 1; done",
    "nhanes:muestra": "tsc -p tsconfig.ml.json && node .tmp-test/ml/scripts/nhanes-muestra.js",
    "entrenar:nhanes": "tsc -p tsconfig.ml.json && node .tmp-test/ml/scripts/entrenar-nhanes.js",
    "figuras": "tsc -p tsconfig.ml.json && node .tmp-test/ml/scripts/exportar-figuras.js docs/figuras/datos-figuras.json && python3 scripts/figuras.py"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@google/genai": "^0.7.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "ai": "^4.3.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.503.0",
    "next": "^15.3.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.2.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "^15.3.0",
    "tailwindcss": "^4",
    "typescript": "5.8.2"
  }
}
